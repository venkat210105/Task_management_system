PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task_management
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Gmail SMTP for password reset emails
# EMAIL_USER: your Gmail address
# EMAIL_PASS: a Gmail App Password (myaccount.google.com/apppasswords), not your login password
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Task Tracker <your_email@gmail.com>
